# 한국어 비속어 사용자 지정 단어 (spec 018, research R4)
#
# - 가드레일 모욕 필터는 문장의 의도를 봐서 "시발", "존나"처럼 단독·감탄사 비속어를 못 잡는다(R1 실측).
# - 단어 필터는 문맥을 보지 않는다. 그래서 단독으로 써도 비속어로만 읽히는 단어와 대표 변형만 넣는다.
#   정상 단어와 글자가 겹치면 넣지 않는다("미친" → "미친 듯이", "새끼" → "새끼줄", "졸라").
# - 조건부: "시발"(시발점·시발역), "병신"(병신년 丙申年)은 붙은 글자까지 잡는지 시험한 뒤 남길지 정한다.
#   시험 문장 pl01~pl03·pl07이 막히면 뺀다.
# - 2026-11-27 시험(v4): 단어 필터는 띄어쓰기 단위로 통째로 같은 단어만 잡는다. 그래서 시발점·시발역·
#   병신년은 통과하고(시발·병신 유지), 붙은 형태(좆같은, 지랄하지, 시발놈아)는 못 잡는다.
#   자주 쓰는 붙은 형태만 골라 더한다(30개 이하). "시발 운행"(始發, 띄어 씀)은 받아들인 오탐이다.
# - 바꾸면 새 가드레일 버전이 생긴다. 실제 차단은 guardrail_enforce에 words가 있을 때만(R3).

locals {
  profanity_words = [
    "씨발", "씨바", "씨팔", # 대표 욕설과 흔한 변형
    "ㅅㅂ", "ㅆㅂ", "ㅂㅅ", # 초성 표기
    "존나", "존나게",      # 감탄 비속어(v3에서 안 걸림)
    "좆", "좆같",
    "개새끼", "개새",
    "미친놈", "미친년", # "미친" 단독은 정상 표현과 겹쳐 대상 형태만
    "지랄",
    "엿먹어",
    "시발", # 시발점·시발역은 통과(v4 시험). "시발 운행"처럼 띄어 쓴 始發은 받아들인 오탐
    "병신", # 병신년은 통과(v4 시험)
    # 자주 쓰는 붙은 형태(v4에서 못 잡음 또는 흔한 호칭형)
    "좆같은", "좆같네", "좆까",
    "지랄하지", "지랄하네",
    "시발놈아", "씨발놈아", "개새끼야", "병신아", "미친새끼",
  ]
}
