{
  "Comment": "K-TMS Silver -> ML-ready -> contract check (specs/a-platform/008-ktms-silver-pipeline, 010-ml-ready-contract-check). Input: {start_date, end_date, stage, notify, check_table, expect_source, real_table} all optional. mode comes from Terraform and cannot be overridden by input.",
  "StartAt": "Defaults",
  "States": {
    "Defaults": {
      "Type": "Pass",
      "Parameters": {
        "args.$": "States.JsonMerge(States.JsonMerge(States.StringToJson('{\"start_date\":\"auto\",\"end_date\":\"auto\",\"stage\":\"all\",\"source\":\"ktms\",\"notify\":true,\"check_table\":\"tms_silver2.ktms_ml_ready\",\"expect_source\":null,\"real_table\":null}'), $$.Execution.Input, false), States.StringToJson('{\"mode\":\"${check_mode}\"}'), false)"
      },
      "Next": "RouteSource"
    },
    "RouteSource": {
      "Comment": "source: ktms(실측, 기본) | ktms_synth(학습용 합성, 011). 원본 경로·테이블·실행 기록·검사 입력을 정한다",
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.args.source",
          "StringEquals": "ktms_synth",
          "Next": "SynthSource"
        }
      ],
      "Default": "RealSource"
    },
    "RealSource": {
      "Type": "Pass",
      "Parameters": {
        "args.$": "$.args",
        "src": {
          "source_prefix": "tms_cleansys/",
          "silver_table": "tms_silver2.ktms",
          "silver_runs": "silver2/_runs/ktms",
          "ml_ready_table": "tms_silver2.ktms_ml_ready",
          "ml_ready_runs": "silver2/_runs/ktms_ml_ready",
          "data_source": "ktms"
        }
      },
      "Next": "RouteStart"
    },
    "SynthSource": {
      "Comment": "합성은 원본 tms_synthetic_train_v2/(생성기 v2, spec 015), 테이블 *_synth*, 검사는 출처 ktms_synth + 실측 굴뚝 키 비겹침 (011 research R9)",
      "Type": "Pass",
      "Parameters": {
        "args.$": "States.JsonMerge($.args, States.StringToJson('{\"check_table\":\"tms_silver2.ktms_synth_ml_ready\",\"expect_source\":\"ktms_synth\",\"real_table\":\"tms_silver2.ktms_ml_ready\"}'), false)",
        "src": {
          "source_prefix": "tms_synthetic_train_v2/",
          "silver_table": "tms_silver2.ktms_synth",
          "silver_runs": "silver2/_runs/ktms_synth",
          "ml_ready_table": "tms_silver2.ktms_synth_ml_ready",
          "ml_ready_runs": "silver2/_runs/ktms_synth_ml_ready",
          "data_source": "ktms_synth"
        }
      },
      "Next": "RouteStart"
    },
    "RouteStart": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.args.stage",
          "StringEquals": "ml_ready",
          "Next": "MlReady"
        },
        {
          "Variable": "$.args.stage",
          "StringEquals": "check",
          "Next": "CheckOnly"
        }
      ],
      "Default": "Silver"
    },
    "Silver": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "${silver_job}",
        "Arguments": {
          "--start_date.$": "$.args.start_date",
          "--end_date.$": "$.args.end_date",
          "--sfn_execution.$": "$$.Execution.Name",
          "--source_prefix.$": "$.src.source_prefix",
          "--silver_table.$": "$.src.silver_table",
          "--runs_prefix.$": "$.src.silver_runs"
        }
      },
      "ResultPath": "$.silver",
      "ResultSelector": {
        "JobRunId.$": "$.Id",
        "JobRunState.$": "$.JobRunState"
      },
      "Retry": [
        {
          "ErrorEquals": ["Glue.ConcurrentRunsExceededException"],
          "IntervalSeconds": 120,
          "MaxAttempts": 5,
          "BackoffRate": 1
        },
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 60,
          "MaxAttempts": 1,
          "BackoffRate": 1
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "SilverFailed"
        }
      ],
      "Next": "RouteAfterSilver"
    },
    "RouteAfterSilver": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.args.stage",
          "StringEquals": "silver",
          "Next": "Done"
        }
      ],
      "Default": "MlReady"
    },
    "MlReady": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "${ml_ready_job}",
        "Arguments": {
          "--start_date.$": "$.args.start_date",
          "--end_date.$": "$.args.end_date",
          "--sfn_execution.$": "$$.Execution.Name",
          "--silver_table.$": "$.src.silver_table",
          "--ml_ready_table.$": "$.src.ml_ready_table",
          "--runs_prefix.$": "$.src.ml_ready_runs",
          "--data_source.$": "$.src.data_source"
        }
      },
      "ResultPath": "$.ml_ready",
      "ResultSelector": {
        "JobRunId.$": "$.Id",
        "JobRunState.$": "$.JobRunState"
      },
      "Retry": [
        {
          "ErrorEquals": ["Glue.ConcurrentRunsExceededException"],
          "IntervalSeconds": 120,
          "MaxAttempts": 5,
          "BackoffRate": 1
        },
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 60,
          "MaxAttempts": 1,
          "BackoffRate": 1
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "MlReadyFailed"
        }
      ],
      "Next": "Check"
    },
    "CheckOnly": {
      "Comment": "stage=check: Glue 잡 없이 검사만. ML-ready 실행이 없으므로 범위는 입력 날짜, 스냅샷은 최신 (010 research R3)",
      "Type": "Pass",
      "Result": {
        "JobRunId": null
      },
      "ResultPath": "$.ml_ready",
      "Next": "Check"
    },
    "Check": {
      "Comment": "ML-ready 계약 검사 (010). 읽기 전용 Lambda가 결과와 메일 제목·본문을 돌려준다",
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${check_function}",
        "Payload": {
          "args.$": "$.args",
          "ml_ready_job_run_id.$": "$.ml_ready.JobRunId",
          "sfn_execution.$": "$$.Execution.Name"
        }
      },
      "ResultSelector": {
        "result.$": "$.Payload.result",
        "block.$": "$.Payload.block",
        "subject.$": "$.Payload.subject",
        "message.$": "$.Payload.message",
        "run_record.$": "$.Payload.run_record"
      },
      "ResultPath": "$.check",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2
        },
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 30,
          "MaxAttempts": 1,
          "BackoffRate": 1
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "CheckFailedNotifyGate"
        }
      ],
      "Next": "CheckResult"
    },
    "CheckResult": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.check.result",
          "StringEquals": "passed",
          "Next": "Done"
        }
      ],
      "Default": "CheckNotifyGate"
    },
    "CheckNotifyGate": {
      "Comment": "notify=false면 알림 없이 결과만 남긴다 (010 FR-014)",
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.args.notify",
          "BooleanEquals": false,
          "Next": "CheckOutcome"
        }
      ],
      "Default": "NotifyCheck"
    },
    "NotifyCheck": {
      "Comment": "계약 위반 또는 대상 행 없음. 제목·본문은 Lambda가 만든다 (010 contracts §4)",
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${topic_arn}",
        "Subject.$": "$.check.subject",
        "Message.$": "$.check.message"
      },
      "ResultPath": null,
      "Next": "CheckOutcome"
    },
    "CheckOutcome": {
      "Comment": "block 모드의 위반만 실행 실패. observe 모드와 대상 행 없음은 성공",
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.check.block",
          "BooleanEquals": true,
          "Next": "CheckBlocked"
        }
      ],
      "Default": "Done"
    },
    "CheckBlocked": {
      "Type": "Fail",
      "Error": "KtmsContractViolation",
      "Cause": "ML-ready contract violation in block mode; alert sent to SNS"
    },
    "CheckFailedNotifyGate": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.args.notify",
          "BooleanEquals": false,
          "Next": "CheckFailedOutcome"
        }
      ],
      "Default": "NotifyCheckFailed"
    },
    "NotifyCheckFailed": {
      "Comment": "검사 자체 실패. Lambda 오류는 Cause가 JSON이라 메시지만 꺼내고, 아니면 NotifyCheckFailedRaw가 원문을 보낸다",
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "ParseCheckCause",
          "States": {
            "ParseCheckCause": {
              "Type": "Pass",
              "Parameters": {
                "args.$": "$.args",
                "err.$": "$.error.Error",
                "cause.$": "States.StringToJson($.error.Cause)"
              },
              "Next": "NotifyCheckFailedDetailed"
            },
            "NotifyCheckFailedDetailed": {
              "Type": "Task",
              "Resource": "arn:aws:states:::sns:publish",
              "Parameters": {
                "TopicArn": "${topic_arn}",
                "Subject": "[tms] K-TMS contract check failed",
                "Message.$": "States.Format('K-TMS ML-ready 계약 검사 실행 실패 (재시도 1회 후)\n\n테이블: {}\n범위: {} ~ {}\n오류 종류: {}\n메시지: {}\n로그: CloudWatch /aws/lambda/${check_function}\n실행 기록: s3://${bucket}/silver2/_runs/ktms_ml_ready_check/\n실행 이름: {}\n모드: {}\n\n데이터는 바뀌지 않았다. 검사만 다시 돌리려면 입력 stage=check로 실행한다.\n읽는 법: specs/a-platform/010-ml-ready-contract-check/contracts/check-interface.md', $.args.check_table, $.args.start_date, $.args.end_date, $.err, $.cause.errorMessage, $$.Execution.Name, $.args.mode)"
              },
              "End": true
            }
          }
        }
      ],
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.notify_error",
          "Next": "NotifyCheckFailedRaw"
        }
      ],
      "Next": "CheckFailedOutcome"
    },
    "NotifyCheckFailedRaw": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${topic_arn}",
        "Subject": "[tms] K-TMS contract check failed",
        "Message.$": "States.Format('K-TMS ML-ready 계약 검사 실행 실패 (재시도 1회 후)\n\n테이블: {}\n범위: {} ~ {}\n오류 종류: {}\n원인(원문): {}\n로그: CloudWatch /aws/lambda/${check_function}\n실행 이름: {}\n모드: {}', $.args.check_table, $.args.start_date, $.args.end_date, $.error.Error, $.error.Cause, $$.Execution.Name, $.args.mode)"
      },
      "ResultPath": null,
      "Next": "CheckFailedOutcome"
    },
    "CheckFailedOutcome": {
      "Comment": "검사 실행 실패도 block 모드에서만 실행 실패로 끝낸다",
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.args.mode",
          "StringEquals": "block",
          "Next": "CheckFailedBlocked"
        }
      ],
      "Default": "Done"
    },
    "CheckFailedBlocked": {
      "Type": "Fail",
      "Error": "KtmsContractCheckFailed",
      "Cause": "Contract check failed after retry in block mode; alert sent to SNS"
    },
    "SilverFailed": {
      "Comment": "실패 단계 정보. 메일 본문과 다시 실행 명령에 쓴다. Silver가 실패하면 ML-ready도 안 돌았으므로 stage all로 다시 실행한다",
      "Type": "Pass",
      "Result": {
        "stage": "silver",
        "job": "${silver_job}",
        "runs": "ktms",
        "rerun_stage": "all"
      },
      "ResultPath": "$.failed",
      "Next": "Notify"
    },
    "MlReadyFailed": {
      "Type": "Pass",
      "Result": {
        "stage": "ml_ready",
        "job": "${ml_ready_job}",
        "runs": "ktms_ml_ready",
        "rerun_stage": "ml_ready"
      },
      "ResultPath": "$.failed",
      "Next": "Notify"
    },
    "Notify": {
      "Comment": "Glue 실패 원인(JobRun JSON)에서 필요한 값만 꺼내 읽기 좋은 메일을 보낸다. 원인이 JSON이 아니거나 값이 없어 실패하면 NotifyRaw가 원문 그대로 보낸다(알림이 빠지지 않게)",
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "ParseCause",
          "States": {
            "ParseCause": {
              "Type": "Pass",
              "Parameters": {
                "args.$": "$.args",
                "failed.$": "$.failed",
                "run.$": "States.StringToJson($.error.Cause)"
              },
              "Next": "NotifyDetailed"
            },
            "NotifyDetailed": {
              "Type": "Task",
              "Resource": "arn:aws:states:::sns:publish",
              "Parameters": {
                "TopicArn": "${topic_arn}",
                "Subject": "[tms] K-TMS silver2 failed",
                "Message.$": "States.Format('K-TMS Silver/ML-ready 실행 실패 (재시도 1회 후)\n\n단계: {} ({})\n범위: {} ~ {}\n오류: {}\nGlue 실행: {} ({}초, {} x {})\n실행 이름: {}\n\n실행 기록: s3://${bucket}/silver2/_runs/{}/\n다시 실행: python run_ktms.py rerun --from {} --to {} --stage {}\n읽는 법: specs/a-platform/008-ktms-silver-pipeline/contracts/run-interface.md', $.failed.stage, $.failed.job, $.args.start_date, $.args.end_date, $.run.ErrorMessage, $.run.Id, $.run.ExecutionTime, $.run.WorkerType, $.run.NumberOfWorkers, $$.Execution.Name, $.failed.runs, $.args.start_date, $.args.end_date, $.failed.rerun_stage)"
              },
              "End": true
            }
          }
        }
      ],
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.notify_error",
          "Next": "NotifyRaw"
        }
      ],
      "Next": "Failed"
    },
    "NotifyRaw": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${topic_arn}",
        "Subject": "[tms] K-TMS silver2 failed",
        "Message.$": "States.Format('K-TMS Silver/ML-ready 실행 실패 (재시도 1회 후)\n\n단계: {} ({})\n범위: {} ~ {}\n오류 종류: {}\n원인(원문): {}\n실행 이름: {}\n\n실행 기록: s3://${bucket}/silver2/_runs/{}/\n다시 실행: python run_ktms.py rerun --from {} --to {} --stage {}', $.failed.stage, $.failed.job, $.args.start_date, $.args.end_date, $.error.Error, $.error.Cause, $$.Execution.Name, $.failed.runs, $.args.start_date, $.args.end_date, $.failed.rerun_stage)"
      },
      "ResultPath": null,
      "Next": "Failed"
    },
    "Failed": {
      "Type": "Fail",
      "Error": "KtmsSilverFailed",
      "Cause": "Glue job failed after retry; alert sent to SNS"
    },
    "Done": {
      "Type": "Succeed"
    }
  }
}
