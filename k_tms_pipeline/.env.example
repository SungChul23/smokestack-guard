# Postgres (Airflow 메타DB + 운영 메타DB 공용 인스턴스)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow

# MinIO (로컬 S3). AWS 전환 시 이 값들은 IAM 키로 대체
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Airflow 컨테이너 실행 UID (Docker Desktop/Windows는 50000 그대로 OK)
AIRFLOW_UID=50000

# 공공데이터포털 서비스키 (프로브 단계에서 사용, 절대 커밋 금지)
DATA_GO_KR_KEY=