FROM apache/spark:3.5.4-scala2.12-java17-python3-ubuntu
USER root
RUN pip3 install --no-cache-dir "numpy<2" "pandas==2.2.3" "pyarrow==16.1.0" "pyspark==3.5.4" boto3 pytest pyyaml
# Kafka 커넥터 (Spark 3.5.4용 의존 jar 4개)
ADD https://repo1.maven.org/maven2/org/apache/spark/spark-sql-kafka-0-10_2.12/3.5.4/spark-sql-kafka-0-10_2.12-3.5.4.jar /opt/spark/jars/
ADD https://repo1.maven.org/maven2/org/apache/spark/spark-token-provider-kafka-0-10_2.12/3.5.4/spark-token-provider-kafka-0-10_2.12-3.5.4.jar /opt/spark/jars/
ADD https://repo1.maven.org/maven2/org/apache/kafka/kafka-clients/3.4.1/kafka-clients-3.4.1.jar /opt/spark/jars/
ADD https://repo1.maven.org/maven2/org/apache/commons/commons-pool2/2.11.1/commons-pool2-2.11.1.jar /opt/spark/jars/
RUN chmod 644 /opt/spark/jars/*.jar
USER spark